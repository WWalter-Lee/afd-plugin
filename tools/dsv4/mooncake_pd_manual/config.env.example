# Copy this file once per role and replace every CHANGE_ME value.

NODE_ROLE="CHANGE_ME"  # prefill, decode, or proxy
DEPLOYMENT_VARIANT="CHANGE_ME"  # pd_control or pd_afd

CODE_ROOT="/data/z00569729/code"
VENV_ROOT="${CODE_ROOT}/.venvs/afd-v023-vllm-cann"
VLLM_ROOT="${CODE_ROOT}/vllm-release-v0.23.0"
VLLM_ASCEND_ROOT="${CODE_ROOT}/vllm-ascend-rfc-vllm-cann"
AFD_PLUGIN_ROOT="${CODE_ROOT}/afd-plugin"
CANN_ROOT="/usr/local/Ascend/cann-9.0.0"
CANN_VERSION="9.0.0"
# Leave empty to auto-detect under CANN_ROOT or /usr/local/Ascend/nnal/atb.
ATB_ROOT=""
MODEL_PATH="/data/z00569729/models/DeepSeek-V4-Flash-w8a8-mtp"
NATIVE_GOLDEN_PATH="/data/z00569729/validation/dsv4_v023_vllm_cann_native_baseline/golden_results.json"
PD_CONTROL_GOLDEN_PATH="/data/z00569729/validation/dsv4_m9_pd_control/golden_results.json"

# existing: keep the package already present in this exact venv; wheel: install the file below.
MOONCAKE_INSTALL_MODE="existing"
MOONCAKE_VERSION="0.3.9"
# Leave empty to auto-detect beside the package or in /usr/local/lib{,64}.
MOONCAKE_LIBRARY_DIR=""
MOONCAKE_WHEEL="/data/z00569729/packages/mooncake_transfer_engine-0.3.9-cp312-cp312-manylinux_2_39_aarch64.whl"

VLLM_COMMIT="0fc695fc6d1d82e9a5ac6835ac8e4e1c83703665"
VLLM_ASCEND_COMMIT="3da28f9414583d2d0b672a8f06d1fae142404bda"
AFD_PD_COMMIT="CHANGE_ME_40_HEX_M9_COMMIT"
MOONCAKE_WHEEL_SHA256="0f9964801b24fd683d6016e1196cc0606fc87b0285b45d89c433650b9477ca12"

# clean: unchanged upstream checkout; batch_invariant_patch: only the delivered
# two-file vLLM-Ascend patch is allowed. Keep disabled through F0; enable only
# for the F1 correctness freeze after all planned functional development.
VLLM_ASCEND_WORKTREE_MODE="clean"
ENABLE_BATCH_INVARIANT="0"
BATCH_INVARIANT_OPP_ROOT="${CODE_ROOT}/.ascend/custom-opp/batch-invariant-a3-1.0.0"

PREFILL_IP="CHANGE_ME_A3_P_IP"
DECODE_IP="CHANGE_ME_A3_D_IP"
NIC_NAME="eth0"

RUN_ROOT="/data/z00569729/run/dsv4-mooncake-${DEPLOYMENT_VARIANT}"
STATE_ROOT="${RUN_ROOT}/state/${NODE_ROLE}"
LOG_ROOT="${RUN_ROOT}/logs/${NODE_ROLE}"
VALIDATION_ROOT="${RUN_ROOT}/validation"
OUTPUT_ROOT="${RUN_ROOT}/output"

PREFILL_API_PORT="8100"
DECODE_API_PORT="8910"
FFN_PROCESS_PORT="8911"
PROXY_PORT="9000"
AFD_PORT="29761"
PREFILL_KV_PORT="30000"
DECODE_KV_PORT="30100"
CONTROL_DATA_PARALLEL_RPC_PORT="29360"
CONTROL_MASTER_PORT="29361"
PREFILL_HCCL_IF_BASE_PORT="50000"
ATTENTION_HCCL_IF_BASE_PORT="51000"
FFN_HCCL_IF_BASE_PORT="52000"
MC_MIN_PRC_PORT="15000"
MC_MAX_PRC_PORT="17000"

PREFILL_DEVICES="0,1,2,3,4,5,6,7"
ATTENTION_DEVICES="0,1,2,3,4,5,6,7"
FFN_DEVICES="8,9,10,11,12,13,14,15"
PREFILL_DP_SIZE="2"
PREFILL_TP_SIZE="4"
ATTENTION_RANKS="8"
FFN_RANKS="8"
DECODE_DP_SIZE="8"
DECODE_TP_SIZE="1"
# After the TP1 path-matched F0, switch both values together to DP4/TP2:
# DECODE_DP_SIZE="4"
# DECODE_TP_SIZE="2"

# Validate one combination at a time and use a combination-specific RUN_ROOT.
# F0 checks function/data-path behavior and does not compare golden. The
# combination-specific PD_CONTROL_GOLDEN_PATH is consumed later by F1.
DECODE_EXECUTION_MODE="eager"  # eager or full-decode-only
DECODE_U_BATCHES="1"  # 1 or 2
DECODE_ENABLE_MTP="0"  # 0 or 1
DECODE_MTP_DRAFT_EXECUTION="eager"  # eager or graph
DECODE_MTP_NUM_SPECULATIVE_TOKENS="1"
DECODE_DBO_DECODE_TOKEN_THRESHOLD="2"
DECODE_DBO_PREFILL_TOKEN_THRESHOLD="12"
DECODE_MAX_CUDAGRAPH_CAPTURE_SIZE="8"
DECODE_CUDAGRAPH_CAPTURE_SIZES="1 2 4 8"

MAX_MODEL_LEN="4096"
MAX_NUM_BATCHED_TOKENS="4096"
MAX_NUM_SEQS="16"
GPU_MEMORY_UTILIZATION="0.90"
HCCL_BUFFSIZE="2048"
OMP_NUM_THREADS="10"
MODEL_NAME="dsv4-afd"

INSTALL_SYSTEM_PACKAGES="0"
RUN_LOCAL_ROUNDTRIP="1"
ROUNDTRIP_PRODUCER_DEVICE="0"
ROUNDTRIP_CONSUMER_DEVICE="1"
WAIT_READY="1"
STARTUP_TIMEOUT_SECONDS="3600"
STOP_TIMEOUT_SECONDS="300"
FORCE_KILL="0"
ALLOW_NPU_PROCESSES="0"
# Single-host PD control only: allow the tracked Prefill process while Decode
# uses a strictly disjoint ATTENTION_DEVICES set. Never enable for pd_afd.
ALLOW_COLOCATED_PD_CONTROL="0"
COLOCATED_PREFILL_PID_FILE="${RUN_ROOT}/state/prefill/prefill.pid"

VALIDATION_ROUNDS="3"
VALIDATION_BATCH_SIZES="1 8 32"
RUN_CANCELLATION_TEST="1"

# collect never includes full logs, wheels, models, profiler data, or core dumps.
ARTIFACT_LOG_TAIL_BYTES="262144"
ARTIFACT_MAX_BYTES="2097152"
